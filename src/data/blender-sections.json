  {
    "num": "03",
    "title": "Transform",
    "twoCol": false,
    "alt": false,
    "rows": [
      {
        "desc": "<b>Grab / move</b>",
        "keys": "<kbd class=\"accent\">G</kbd>"
      },
      {
        "desc": "<b>Rotate</b>",
        "keys": "<kbd class=\"accent\">R</kbd>"
      },
      {
        "desc": "<b>Scale</b>",
        "keys": "<kbd class=\"accent\">S</kbd>"
      },
      {
        "desc": "Constrain to axis",
        "keys": "<kbd>X</kbd> <span class=\"or\">/</span> <kbd>Y</kbd> <span class=\"or\">/</span> <kbd>Z</kbd>"
      },
      {
        "desc": "Exclude axis",
        "keys": "<kbd>Shift</kbd><span class=\"plus\">+</span><kbd>X/Y/Z</kbd>"
      },
      {
        "desc": "Local axis",
        "keys": "press <kbd>X/Y/Z</kbd> twice"
      },
      {
        "desc": "Type exact value",
        "keys": "<kbd>1</kbd>…<kbd>9</kbd>"
      },
      {
        "desc": "Fine adjust",
        "keys": "hold <kbd>Shift</kbd>"
      },
      {
        "desc": "Snap during move",
        "keys": "hold <kbd>Ctrl</kbd>"
      },
      {
        "desc": "Double tap rotate",
        "keys": "<kbd>R</kbd><kbd>R</kbd> <span class=\"or\">trackball</span>"
      },
      {
        "desc": "Confirm / Cancel",
        "keys": "<kbd>Enter</kbd> <span class=\"or\">/</span> <kbd>Esc</kbd>"
      },
      {
        "desc": "<b>Apply transforms</b>",
        "keys": "<kbd>Ctrl</kbd><span class=\"plus\">+</span><kbd>A</kbd>"
      }
    ],
    "notes": [
      "<strong>Workflow:</strong> <kbd>G</kbd> → <kbd>Z</kbd> → <kbd>2</kbd> → <kbd>Enter</kbd> moves 2m up."
    ]
  },
